<?xml version="1.0" encoding="utf-8"?>
<!--
  La base SQLite y las preferencias tienen datos financieros y Supabase ya es el
  respaldo. Se excluye todo del respaldo en la nube y de la transferencia entre
  dispositivos (Android 12+; allowBackup="false" solo apaga la nube). Restaurar
  una base vieja con filas pendientes podría además pisar datos nuevos al subir.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
